// =============================================================================
// WhatsApp Business Platform — Complete Prisma Schema (All Phases)
// =============================================================================

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
}

// =============================================================================
// PHASE 1 — Core Models
// =============================================================================

enum Role {
  OWNER
  AGENT
}

enum PhoneNumberStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum QualityRating {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  TEMPLATE
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
  STICKER
  LOCATION
  CONTACTS
  INTERACTIVE
  REACTION
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum TemplateStatus {
  PENDING
  APPROVED
  REJECTED
}

// --- Users & Organizations ---

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique
  passwordHash        String               @map("password_hash")
  firstName           String               @map("first_name")
  lastName            String               @map("last_name")
  avatarUrl           String?              @map("avatar_url")
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  memberships         OrganizationMember[]
  assignedConversations Conversation[]     @relation("AssignedAgent")
  notes               Note[]
  aiConversations     AiConversation[]
  activities          Activity[]
  auditLogs           AuditLog[]           @relation("AuditActor")

  @@map("users")
}

model Organization {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  slug                String               @unique
  planId              String?              @map("plan_id") @db.Uuid
  timezone            String               @default("UTC")
  metaBusinessId      String?              @map("meta_business_id")
  logoUrl             String?              @map("logo_url")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  // Relations
  plan                Plan?                @relation(fields: [planId], references: [id])
  members             OrganizationMember[]
  phoneNumbers        PhoneNumber[]
  contacts            Contact[]
  conversations       Conversation[]
  templates           Template[]
  broadcasts          Broadcast[]
  tags                Tag[]
  customFields        CustomField[]
  cannedResponses     CannedResponse[]
  workflows           Workflow[]
  knowledgeBaseDocs   KnowledgeBaseDocument[]
  pipelines           Pipeline[]
  apiKeys             ApiKey[]
  webhookSubscriptions WebhookSubscription[]
  usageRecords        UsageRecord[]
  auditLogs           AuditLog[]
  ssoConfig           SsoConfig?
  whiteLabelConfig    WhiteLabelConfig?
  featureFlags        FeatureFlag[]

  @@map("organizations")
}

model OrganizationMember {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  role            Role         @default(AGENT)
  isActive        Boolean      @default(true) @map("is_active")
  joinedAt        DateTime     @default(now()) @map("joined_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

// --- WhatsApp ---

model PhoneNumber {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  wabaId          String            @map("waba_id")
  phoneNumberId   String            @map("phone_number_id")
  displayNumber   String            @map("display_number")
  status          PhoneNumberStatus @default(PENDING)
  qualityRating   QualityRating     @default(UNKNOWN) @map("quality_rating")
  routingMethod   RoutingMethod     @default(MANUAL) @map("routing_method")
  accessToken     String?           @map("access_token")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations   Conversation[]

  @@unique([organizationId, phoneNumberId])
  @@map("phone_numbers")
}

// --- Contacts ---

model Contact {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  waId            String       @map("wa_id")
  name            String?
  email           String?
  optedIn         Boolean      @default(false) @map("opted_in")
  optedInAt       DateTime?    @map("opted_in_at")
  optedInSource   String?      @map("opted_in_source")
  lastMessageAt   DateTime?    @map("last_message_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations   Conversation[]
  tags            ContactTag[]
  customFieldValues ContactCustomFieldValue[]
  deals           Deal[]
  workflowExecutions WorkflowExecution[]

  @@unique([organizationId, waId])
  @@index([organizationId, lastMessageAt])
  @@map("contacts")
}

// --- Conversations & Messages ---

model Conversation {
  id                      String             @id @default(uuid()) @db.Uuid
  organizationId          String             @map("organization_id") @db.Uuid
  contactId               String             @map("contact_id") @db.Uuid
  phoneNumberId           String             @map("phone_number_id") @db.Uuid
  assignedAgentId         String?            @map("assigned_agent_id") @db.Uuid
  status                  ConversationStatus @default(OPEN)
  channel                 String             @default("whatsapp")
  lastCustomerMessageAt   DateTime?          @map("last_customer_message_at")
  unreadCount             Int                @default(0) @map("unread_count")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  organization            Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact                 Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  phoneNumber             PhoneNumber        @relation(fields: [phoneNumberId], references: [id])
  assignedAgent           User?              @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  messages                Message[]
  notes                   Note[]
  aiConversations         AiConversation[]
  deals                   Deal[]

  @@unique([organizationId, contactId, phoneNumberId])
  @@index([organizationId, status])
  @@index([organizationId, assignedAgentId])
  @@index([lastCustomerMessageAt])
  @@map("conversations")
}

model Message {
  id              String           @id @default(uuid()) @db.Uuid
  conversationId  String           @map("conversation_id") @db.Uuid
  direction       MessageDirection
  waMessageId     String?          @unique @map("wa_message_id")
  type            MessageType      @default(TEXT)
  content         Json             @db.JsonB
  status          MessageStatus    @default(QUEUED)
  templateId      String?          @map("template_id") @db.Uuid
  broadcastId     String?          @map("broadcast_id") @db.Uuid
  errorCode       String?          @map("error_code")
  errorMessage    String?          @map("error_message")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  template        Template?        @relation(fields: [templateId], references: [id])

  @@index([conversationId, createdAt])
  @@index([waMessageId])
  @@index([status])
  @@map("messages")
}

// --- Templates ---

model Template {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  name            String
  category        TemplateCategory
  language        String           @default("en")
  status          TemplateStatus   @default(PENDING)
  metaTemplateId  String?          @map("meta_template_id")
  components      Json             @db.JsonB
  rejectionReason String?          @map("rejection_reason")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages        Message[]
  broadcasts      Broadcast[]

  @@unique([organizationId, name, language])
  @@map("templates")
}

// =============================================================================
// PHASE 2 — Retention Models
// =============================================================================

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  COMPLETED
  FAILED
}

enum BroadcastRecipientStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  OPTED_OUT
}

enum RoutingMethod {
  MANUAL
  ROUND_ROBIN
  LEAST_BUSY
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
}

model Broadcast {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  templateId        String          @map("template_id") @db.Uuid
  name              String
  audienceFilter    Json?           @map("audience_filter") @db.JsonB
  status            BroadcastStatus @default(DRAFT)
  totalRecipients   Int             @default(0) @map("total_recipients")
  sentCount         Int             @default(0) @map("sent_count")
  deliveredCount    Int             @default(0) @map("delivered_count")
  readCount         Int             @default(0) @map("read_count")
  failedCount       Int             @default(0) @map("failed_count")
  scheduledAt       DateTime?       @map("scheduled_at")
  startedAt         DateTime?       @map("started_at")
  completedAt       DateTime?       @map("completed_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template          Template        @relation(fields: [templateId], references: [id])
  recipients        BroadcastRecipient[]

  @@index([organizationId, status])
  @@index([scheduledAt])
  @@map("broadcasts")
}

model BroadcastRecipient {
  id              String                   @id @default(uuid()) @db.Uuid
  broadcastId     String                   @map("broadcast_id") @db.Uuid
  contactId       String                   @map("contact_id") @db.Uuid
  waMessageId     String?                  @map("wa_message_id")
  status          BroadcastRecipientStatus @default(PENDING)
  errorCode       String?                  @map("error_code")
  sentAt          DateTime?                @map("sent_at")
  deliveredAt     DateTime?                @map("delivered_at")
  readAt          DateTime?                @map("read_at")

  broadcast       Broadcast                @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, contactId])
  @@index([broadcastId, status])
  @@map("broadcast_recipients")
}

model Tag {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  name            String
  color           String       @default("#6c7a75")
  createdAt       DateTime     @default(now()) @map("created_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts        ContactTag[]

  @@unique([organizationId, name])
  @@map("tags")
}

model ContactTag {
  contactId       String   @map("contact_id") @db.Uuid
  tagId           String   @map("tag_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  contact         Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag             Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

model CustomField {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  name            String
  type            CustomFieldType @default(TEXT)
  options         Json?           @db.JsonB
  isRequired      Boolean         @default(false) @map("is_required")
  createdAt       DateTime        @default(now()) @map("created_at")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values          ContactCustomFieldValue[]

  @@unique([organizationId, name])
  @@map("custom_fields")
}

model ContactCustomFieldValue {
  id              String      @id @default(uuid()) @db.Uuid
  contactId       String      @map("contact_id") @db.Uuid
  customFieldId   String      @map("custom_field_id") @db.Uuid
  value           String
  updatedAt       DateTime    @updatedAt @map("updated_at")

  contact         Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  customField     CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([contactId, customFieldId])
  @@map("contact_custom_field_values")
}

model CannedResponse {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  shortcut        String
  title           String
  body            String
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, shortcut])
  @@map("canned_responses")
}

model Note {
  id              String       @id @default(uuid()) @db.Uuid
  conversationId  String       @map("conversation_id") @db.Uuid
  authorId        String       @map("author_id") @db.Uuid
  body            String
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author          User         @relation(fields: [authorId], references: [id])

  @@index([conversationId, createdAt])
  @@map("notes")
}

model Plan {
  id                    String         @id @default(uuid()) @db.Uuid
  name                  String         @unique
  displayName           String         @map("display_name")
  priceMonthly          Int            @map("price_monthly")
  priceAnnual           Int            @map("price_annual")
  seatLimit             Int            @map("seat_limit")
  numberLimit           Int            @map("number_limit")
  monthlyMessageLimit   Int            @map("monthly_message_limit")
  broadcastRecipientLimit Int          @map("broadcast_recipient_limit")
  features              Json           @db.JsonB
  isActive              Boolean        @default(true) @map("is_active")
  createdAt             DateTime       @default(now()) @map("created_at")

  organizations         Organization[]

  @@map("plans")
}

model UsageRecord {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  period          String       // Format: YYYY-MM
  metric          String       // e.g., "messages_sent", "broadcasts_sent"
  count           Int          @default(0)
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, period, metric])
  @@map("usage_records")
}

// =============================================================================
// PHASE 3 — Differentiation Models
// =============================================================================

enum WorkflowStatus {
  ACTIVE
  PAUSED
  DRAFT
}

enum WorkflowTriggerType {
  MESSAGE_RECEIVED
  KEYWORD_MATCH
  TAG_ADDED
  STATUS_CHANGED
  CONTACT_CREATED
}

enum WorkflowExecutionStatus {
  RUNNING
  WAITING
  COMPLETED
  FAILED
}

enum AiMode {
  SUGGEST_ONLY
  HUMAN_APPROVAL
  AUTO_WHITELISTED
  FULL_AUTONOMY
}

enum AiActionTaken {
  USED
  EDITED
  REJECTED
}

enum DealStatus {
  OPEN
  WON
  LOST
}

model Workflow {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  name            String
  description     String?
  triggerType     WorkflowTriggerType @map("trigger_type")
  triggerConfig   Json                @map("trigger_config") @db.JsonB
  steps           Json                @db.JsonB // Ordered array of step definitions
  status          WorkflowStatus      @default(DRAFT)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions      WorkflowExecution[]

  @@index([organizationId, status])
  @@map("workflows")
}

model WorkflowExecution {
  id              String                   @id @default(uuid()) @db.Uuid
  workflowId      String                   @map("workflow_id") @db.Uuid
  contactId       String                   @map("contact_id") @db.Uuid
  currentStep     Int                      @default(0) @map("current_step")
  status          WorkflowExecutionStatus  @default(RUNNING)
  context         Json?                    @db.JsonB
  nextRunAt       DateTime?                @map("next_run_at")
  startedAt       DateTime                 @default(now()) @map("started_at")
  completedAt     DateTime?                @map("completed_at")

  workflow        Workflow                 @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  contact         Contact                  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([workflowId, status])
  @@index([nextRunAt])
  @@map("workflow_executions")
}

model AiConversation {
  id              String       @id @default(uuid()) @db.Uuid
  conversationId  String       @map("conversation_id") @db.Uuid
  agentId         String?      @map("agent_id") @db.Uuid
  mode            AiMode
  suggestionText  String       @map("suggestion_text")
  actionTaken     AiActionTaken? @map("action_taken")
  editedText      String?      @map("edited_text")
  sourceChunks    Json?        @map("source_chunks") @db.JsonB
  latencyMs       Int?         @map("latency_ms")
  createdAt       DateTime     @default(now()) @map("created_at")

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent           User?        @relation(fields: [agentId], references: [id])

  @@index([conversationId, createdAt])
  @@map("ai_conversations")
}

model KnowledgeBaseDocument {
  id              String                             @id @default(uuid()) @db.Uuid
  organizationId  String                             @map("organization_id") @db.Uuid
  title           String
  content         String
  embedding       Json?                              @db.JsonB
  chunkIndex      Int                                @default(0) @map("chunk_index")
  status          String                             @default("indexing") // indexing, ready, error
  createdAt       DateTime                           @default(now()) @map("created_at")
  updatedAt       DateTime                           @updatedAt @map("updated_at")

  organization    Organization                       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("knowledge_base_documents")
}

model Pipeline {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  name            String
  isDefault       Boolean         @default(false) @map("is_default")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages          PipelineStage[]

  @@map("pipelines")
}

model PipelineStage {
  id              String   @id @default(uuid()) @db.Uuid
  pipelineId      String   @map("pipeline_id") @db.Uuid
  name            String
  color           String   @default("#006b59")
  position        Int
  createdAt       DateTime @default(now()) @map("created_at")

  pipeline        Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals           Deal[]

  @@unique([pipelineId, position])
  @@map("pipeline_stages")
}

model Deal {
  id              String     @id @default(uuid()) @db.Uuid
  stageId         String     @map("stage_id") @db.Uuid
  contactId       String     @map("contact_id") @db.Uuid
  conversationId  String?    @map("conversation_id") @db.Uuid
  title           String
  value           Decimal?   @db.Decimal(12, 2)
  currency        String     @default("USD")
  status          DealStatus @default(OPEN)
  closedAt        DateTime?  @map("closed_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  stage           PipelineStage @relation(fields: [stageId], references: [id])
  contact         Contact       @relation(fields: [contactId], references: [id])
  conversation    Conversation? @relation(fields: [conversationId], references: [id])
  activities      Activity[]

  @@index([stageId])
  @@map("deals")
}

model Activity {
  id              String   @id @default(uuid()) @db.Uuid
  dealId          String   @map("deal_id") @db.Uuid
  userId          String?  @map("user_id") @db.Uuid
  type            String   // stage_change, note, task, call, email
  title           String
  description     String?
  metadata        Json?    @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at")

  deal            Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id])

  @@index([dealId, createdAt])
  @@map("activities")
}

model ApiKey {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  name            String
  keyHash         String       @unique @map("key_hash")
  keyPrefix       String       @map("key_prefix") // First 8 chars for display
  scopes          Json         @db.JsonB // Array of allowed scopes
  lastUsedAt      DateTime?    @map("last_used_at")
  expiresAt       DateTime?    @map("expires_at")
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@map("api_keys")
}

model WebhookSubscription {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  url             String
  events          Json               @db.JsonB // Array of event types
  secret          String
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries      WebhookDelivery[]

  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id              String              @id @default(uuid()) @db.Uuid
  subscriptionId  String              @map("subscription_id") @db.Uuid
  event           String
  payload         Json                @db.JsonB
  status          String              @default("pending") // pending, success, failed
  httpStatus      Int?                @map("http_status")
  attempts        Int                 @default(0)
  lastAttemptedAt DateTime?           @map("last_attempted_at")
  response        String?
  createdAt       DateTime            @default(now()) @map("created_at")

  subscription    WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@map("webhook_deliveries")
}

// =============================================================================
// PHASE 4 — Enterprise Models
// =============================================================================

model AuditLog {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  actorId         String?      @map("actor_id") @db.Uuid
  action          String       // auth.login, member.invite, template.create, etc.
  targetType      String?      @map("target_type")
  targetId        String?      @map("target_id")
  before          Json?        @db.JsonB
  after           Json?        @db.JsonB
  ipAddress       String?      @map("ip_address")
  userAgent       String?      @map("user_agent")
  createdAt       DateTime     @default(now()) @map("created_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor           User?        @relation("AuditActor", fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@map("audit_logs")
}

model SsoConfig {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @unique @map("organization_id") @db.Uuid
  provider        String       // oidc, saml
  issuerUrl       String?      @map("issuer_url")
  clientId        String?      @map("client_id")
  clientSecret    String?      @map("client_secret")
  metadataUrl     String?      @map("metadata_url")
  isEnabled       Boolean      @default(false) @map("is_enabled")
  scimEnabled     Boolean      @default(false) @map("scim_enabled")
  scimToken       String?      @map("scim_token")
  lastSyncAt      DateTime?    @map("last_sync_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("sso_configs")
}

model WhiteLabelConfig {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @unique @map("organization_id") @db.Uuid
  customDomain    String?      @unique @map("custom_domain")
  logoUrl         String?      @map("logo_url")
  faviconUrl      String?      @map("favicon_url")
  primaryColor    String?      @map("primary_color")
  accentColor     String?      @map("accent_color")
  companyName     String?      @map("company_name")
  dnsVerified     Boolean      @default(false) @map("dns_verified")
  sslProvisioned  Boolean      @default(false) @map("ssl_provisioned")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("white_label_configs")
}

model FeatureFlag {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  feature         String       // e.g., "ai_assistant", "white_label", "sso", "audit_logs"
  isEnabled       Boolean      @default(false) @map("is_enabled")
  config          Json?        @db.JsonB
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, feature])
  @@map("feature_flags")
}

// =============================================================================
// Marketing / Leads (Landing Page)
// =============================================================================

model Lead {
  id              String   @id @default(uuid()) @db.Uuid
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  email           String
  phone           String?
  companyName     String?  @map("company_name")
  companySize     String?  @map("company_size")
  source          String?
  interests       Json?    @db.JsonB
  message         String?
  status          String   @default("new") // new, contacted, qualified, converted
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("leads")
}

model NewsletterSubscriber {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}
