# ========================
# WhatsApp Business Platform
# Environment Configuration
# ========================

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsapp_platform?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- JWT ---
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"

# --- Meta WhatsApp Cloud API ---
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_WEBHOOK_VERIFY_TOKEN="your-webhook-verify-token"
META_API_VERSION="v21.0"
META_GRAPH_API_URL="https://graph.facebook.com"

# --- S3-Compatible Storage (for media attachments) ---
S3_BUCKET="whatsapp-platform-media"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-s3-access-key"
S3_SECRET_ACCESS_KEY="your-s3-secret-key"
S3_ENDPOINT=""

# --- AI Provider (Phase 3) ---
AI_PROVIDER="openai"
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""

# --- Email (for invites, password reset) ---
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="resend"
SMTP_PASSWORD="your-resend-api-key"
EMAIL_FROM="noreply@yourdomain.com"

# --- App URLs ---
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
LANDING_URL="http://localhost:3002"

# --- Encryption ---
ENCRYPTION_KEY="your-32-byte-encryption-key-here"
